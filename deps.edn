{:deps
 {ubergraph/ubergraph {:mvn/version "0.9.0"}
  manifold/manifold {:mvn/version "0.5.0"}
  metosin/malli {:mvn/version "0.20.1"}
  org.clojure/test.check {:mvn/version "1.1.3"}}
 :aliases
 {:dev {:extra-paths ["test"]
        :extra-deps {nrepl/nrepl {:mvn/version "1.3.0"}
                     lambdaisland/kaocha {:mvn/version "1.91.1392"}}}
  :nrepl {:extra-deps {nrepl/nrepl {:mvn/version "1.3.0"}}
          :main-opts ["-m" "nrepl.cmdline"]}
  :test {:main-opts ["-m" "kaocha.runner"]}
  ;; clojure -X:notebook renders notebook/tutorial.clj to docs/tutorial.html. :render
  ;; implies show/serve/browse false, so it needs no browser; drop it for a live page.
  :notebook {:extra-paths ["notebook"]
             :extra-deps {org.scicloj/clay {:mvn/version "2.0.22"}}
             :exec-fn scicloj.clay.v2.api/make!
             :exec-args {:source-path "notebook/tutorial.clj" :render true}}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "RELEASE"}}
         :main-opts ["-m" "clj-kondo.main"]}
  ;; clojure -T:build ci | deploy — see build.clj. The author's other libraries build the
  ;; same way, on the same fork of build-clj.
  :build {:deps {io.github.robertluo/build-clj {:git/sha "5d45f58cc20747c136bb320c9b13d65d2bf4cf58"}}
          :ns-default build}}}
